---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import { products, related, formatPrice, discountPercent, typeLabels, variantsOf, lineName, type Product } from '../../lib/catalog';
import { productImage } from '../../lib/images';
import { waLink } from '../../lib/whatsapp';
import { site } from '../../data/site';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product: p } = Astro.props as { product: Product };
const variants = variantsOf(p);
const v0 = variants[0];
const multi = variants.length > 1;
const others = related(p);
const tone = p.ranges.includes('rose') && !p.ranges.includes('argan') ? 'rose' : 'argan';
const rangeLinks = p.ranges.map((r) => ({ href: `/${r}`, label: r === 'argan' ? 'Gamme argan' : 'Gamme rose' }));
const og = await getImage({ src: productImage(v0.image), width: 1200, height: 630, fit: 'cover', format: 'jpg' });

const orderText = (name: string, price: number) => `je souhaite commander : 1 × ${name} (${formatPrice(price)}).`;
/** Data the client script needs to switch formats. */
const variantData = variants.map((v) => ({
  slug: v.slug,
  price: formatPrice(v.price),
  compareAt: v.compareAt ? formatPrice(v.compareAt) : '',
  off: discountPercent(v.price, v.compareAt),
  tagline: v.tagline,
  composition: v.composition,
  organic: v.organic,
  name: lineName(p, v),
  wa: waLink(orderText(lineName(p, v), v.price)),
}));

const offer = (price: number) => ({
  '@type': 'Offer',
  url: `${site.url}/produit/${p.slug}`,
  priceCurrency: 'EUR',
  price: (price / 100).toFixed(2),
  availability: p.soldOut ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
  areaServed: 'FR',
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.description,
  image: new URL(og.src, site.url).href,
  brand: { '@type': 'Brand', name: site.name },
  category: typeLabels[p.type],
  offers: multi ? variants.map((v) => offer(v.price)) : offer(v0.price),
};
---
<Base title={p.name} description={`${v0.tagline}. ${multi ? 'Dès ' : ''}${formatPrice(Math.min(...variants.map((v) => v.price)))}, commande sur WhatsApp.`} image={og.src} jsonLd={jsonLd}>
  <article class:list={['product', `product--${tone}`]} data-product>
    <div class="container product-grid">
      <div class="product-media">
        <div class="product-arch arch" data-tilt>
          {variants.map((v, i) => (
            <Image
              src={productImage(v.image)}
              alt={lineName(p, v)}
              widths={[480, 800, 1100]}
              sizes="(max-width: 900px) 90vw, 45vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              class:list={['product-img', i === 0 && 'is-active']}
              data-variant-image={v.slug}
            />
          ))}
          {p.soldOut && <span class="product-flag">Épuisé</span>}
          <span class="product-flag product-flag--promo" data-v-off hidden={!discountPercent(v0.price, v0.compareAt)}>-{discountPercent(v0.price, v0.compareAt)} %</span>
        </div>
      </div>

      <div class="product-info">
        <nav aria-label="Fil d’Ariane" class="crumbs">
          <a href="/">Accueil</a> <span aria-hidden="true">/</span>
          <a href={rangeLinks[0].href}>{rangeLinks[0].label}</a> <span aria-hidden="true">/</span>
          <span aria-current="page">{p.name}</span>
        </nav>
        <ul role="list" class="chips">
          {rangeLinks.map((r) => <li><a href={r.href}>{r.label}</a></li>)}
          <li><span>{typeLabels[p.type]}</span></li>
          <li data-v-organic hidden={!v0.organic}><span class="chip-bio">Certifié bio</span></li>
        </ul>
        <h1 data-split="load">{p.name}</h1>
        <p class="lede" data-v-tagline>{v0.tagline}</p>

        {multi && (
          <fieldset class="formats">
            <legend>Format</legend>
            <div class="formats-list">
              {variants.map((v, i) => (
                <label class="format">
                  <input type="radio" name="format" value={v.slug} checked={i === 0} />
                  <span class="format-label">{v.label}</span>
                  <span class="format-price">{formatPrice(v.price)}</span>
                </label>
              ))}
            </div>
          </fieldset>
        )}

        <p class="product-price">
          <span data-v-price>{formatPrice(v0.price)}</span>
          <s data-v-compare hidden={!v0.compareAt}>{v0.compareAt ? formatPrice(v0.compareAt) : ''}</s>
          <small>prix TTC à l’unité</small>
        </p>

        {p.soldOut ? (
          <div class="product-actions" data-buy-anchor>
            <p class="soldout-note">Ce soin est momentanément épuisé.</p>
            <a class="btn" href={waLink(`prévenez-moi quand « ${p.name} » sera de nouveau disponible.`)} target="_blank" rel="noopener">
              <Icon name="whatsapp" /> Me prévenir de son retour
            </a>
          </div>
        ) : (
          <div class="product-actions" data-buy-anchor>
            <button type="button" class:list={['btn', tone === 'rose' && 'btn--rose']} data-add={v0.slug} data-v-add data-magnetic>
              <Icon name="plus" /> Ajouter au panier
            </button>
            <a class="btn btn--ghost" href={variantData[0].wa} target="_blank" rel="noopener" data-v-wa>
              <Icon name="whatsapp" /> Commander ce soin seul
            </a>
          </div>
        )}
        <p class="product-reassure">-{site.bundleDiscount.percent} % dès {site.bundleDiscount.minItems} produits. Livraison en {site.delivery.zone}, frais confirmés avant paiement.</p>

        <div class="product-desc">
          <p>{p.description}</p>
        </div>

        {p.benefits.length > 0 && (
          <section class="benefits" aria-labelledby="benefits-title">
            <h2 id="benefits-title">Ce que vous allez aimer</h2>
            <ul role="list">
              {p.benefits.map((b) => <li>{b}</li>)}
            </ul>
          </section>
        )}

        <div class="details">
          <details open>
            <summary>Conseils d’utilisation</summary>
            <p>{p.usage}</p>
          </details>
          <details>
            <summary>Composition</summary>
            <p data-v-composition>{v0.composition}</p>
            <p class="small">Liste indicative. La liste INCI complète figure sur l’emballage du produit et fait foi.</p>
          </details>
          <details>
            <summary>Précautions d’emploi</summary>
            <ul>
              {p.essentialOil && <li>Ne pas appliquer pure sur la peau : diluer dans une huile végétale. Ne pas ingérer.</li>}
              {p.essentialOil && <li>Déconseillée aux femmes enceintes ou allaitantes, aux jeunes enfants, et aux personnes asthmatiques ou épileptiques sans avis médical.</li>}
              <li>Usage externe uniquement.</li>
              <li>Faites un essai sur une petite zone de peau (pli du coude) 48 h avant la première utilisation.</li>
              <li>Évitez le contour des yeux et les muqueuses. En cas de contact, rincez abondamment à l’eau claire.</li>
              <li>Cessez l’utilisation en cas de rougeur ou d’irritation.</li>
              <li>Tenir hors de portée des enfants. Conserver à l’abri de la chaleur et de la lumière.</li>
            </ul>
          </details>
          <details>
            <summary>Livraison et retours</summary>
            <p>Livraison en {site.delivery.zone}, {site.delivery.delay}. Vous disposez de 14 jours pour changer d’avis sur un produit non ouvert. <a href="/livraison-retours">Tout savoir sur la livraison et les retours</a>.</p>
          </details>
        </div>
      </div>
    </div>
  </article>

  <div class="buybar" data-buybar aria-hidden="true">
    <div class="buybar-info">
      <p class="buybar-name" data-v-name>{lineName(p, v0)}</p>
      <p class="buybar-price"><span data-v-price>{formatPrice(v0.price)}</span><s data-v-compare hidden={!v0.compareAt}>{v0.compareAt ? formatPrice(v0.compareAt) : ''}</s></p>
    </div>
    {p.soldOut ? (
      <a class="btn" tabindex="-1" href={waLink(`prévenez-moi quand « ${p.name} » sera de nouveau disponible.`)} target="_blank" rel="noopener">Me prévenir</a>
    ) : (
      <button type="button" tabindex="-1" class:list={['btn', tone === 'rose' && 'btn--rose']} data-add={v0.slug} data-v-add><Icon name="plus" /> Ajouter</button>
    )}
  </div>

  <script type="application/json" id="variant-data" set:html={JSON.stringify(variantData)} />

  {others.length > 0 && (
    <section class="section related" aria-labelledby="related-title">
      <div class="container">
        <h2 id="related-title" data-split>À associer dans votre rituel</h2>
        <ul role="list" class="related-grid">
          {others.map((o) => <li><ProductCard product={o} /></li>)}
        </ul>
      </div>
    </section>
  )}
</Base>

<script>
  // Format selector: swaps photo, price, texts and the basket / WhatsApp targets.
  const dataEl = document.getElementById('variant-data');
  const formats = document.querySelector<HTMLFieldSetElement>('.formats');
  if (dataEl && formats) {
    type V = { slug: string; price: string; compareAt: string; off: number; tagline: string; composition: string; organic: boolean; name: string; wa: string };
    const variants: V[] = JSON.parse(dataEl.textContent || '[]');
    const all = <T extends HTMLElement>(sel: string) => document.querySelectorAll<T>(sel);
    formats.addEventListener('change', (e) => {
      const v = variants.find((x) => x.slug === (e.target as HTMLInputElement).value);
      if (!v) return;
      all('[data-variant-image]').forEach((img) => img.classList.toggle('is-active', img.dataset.variantImage === v.slug));
      all('[data-v-price]').forEach((el) => (el.textContent = v.price));
      all('[data-v-compare]').forEach((el) => { el.textContent = v.compareAt; el.hidden = !v.compareAt; });
      all('[data-v-off]').forEach((el) => { el.textContent = `-${v.off} %`; el.hidden = !v.off; });
      all('[data-v-tagline]').forEach((el) => (el.textContent = v.tagline));
      all('[data-v-composition]').forEach((el) => (el.textContent = v.composition));
      all('[data-v-name]').forEach((el) => (el.textContent = v.name));
      all('[data-v-organic]').forEach((el) => (el.hidden = !v.organic));
      all('[data-v-add]').forEach((el) => (el.dataset.add = v.slug));
      all<HTMLAnchorElement>('[data-v-wa]').forEach((el) => (el.href = v.wa));
    });
  }

  // Mobile buy bar: shown once the main purchase buttons have scrolled out of view.
  const bar = document.querySelector<HTMLElement>('[data-buybar]');
  const anchor = document.querySelector<HTMLElement>('[data-buy-anchor]');
  if (bar && anchor && 'IntersectionObserver' in window) {
    const mq = matchMedia('(max-width: 900px)');
    new IntersectionObserver(([entry]) => {
      const show = mq.matches && !entry.isIntersecting && entry.boundingClientRect.top < 0;
      bar.classList.toggle('is-visible', show);
      bar.setAttribute('aria-hidden', String(!show));
      bar.querySelectorAll<HTMLElement>('a, button').forEach((el) => (el.tabIndex = show ? 0 : -1));
      document.documentElement.classList.toggle('has-buybar', show);
    }).observe(anchor);
  }
</script>

<style>
  .buybar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 55;
    display: none; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.75rem var(--gutter) calc(0.75rem + env(safe-area-inset-bottom));
    background: rgb(253 248 246 / 0.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 -1px 0 rgb(14 26 60 / 0.1), 0 -12px 30px -18px rgb(14 26 60 / 0.4);
    translate: 0 110%; transition: translate 0.45s var(--ease-out);
  }
  .buybar.is-visible { translate: 0 0; }
  .buybar-info { min-width: 0; }
  .buybar-name { font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .buybar-price { font-family: var(--font-display); color: var(--damas); font-size: 1.15rem; }
  .buybar-price s { font-family: var(--font-body); color: var(--ink-soft); font-size: 0.85rem; margin-left: 0.4rem; }
  .buybar .btn { flex: none; min-height: 2.9rem; padding-inline: 1.2rem; }
  @media (max-width: 900px) { .buybar { display: flex; } }

  .product { padding-block: 7.5rem var(--space-5); }
  .product--argan { background: linear-gradient(to bottom, var(--brume), var(--chaux) 60%); }
  .product--rose { background: linear-gradient(to bottom, var(--aube), var(--chaux) 60%); }
  .product-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .product-media { position: sticky; top: 6.5rem; }
  .product-arch { position: relative; aspect-ratio: 4 / 5; background: var(--blanc); box-shadow: var(--shadow-lift); }
  .product-arch :global(.product-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.5s var(--ease-out); }
  .product-arch :global(.product-img.is-active) { opacity: 1; }
  .product-flag[hidden] { display: none; }

  .formats { border: 0; padding: 0; display: grid; gap: 0.6rem; }
  .formats legend { font-weight: 700; margin-bottom: 0.6rem; }
  .formats-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .format {
    position: relative; display: grid; gap: 0.1rem; min-width: 9.5rem; padding: 0.7rem 1.1rem;
    border-radius: 1.25rem; background: var(--blanc); cursor: pointer;
    box-shadow: inset 0 0 0 1px rgb(14 26 60 / 0.18); transition: box-shadow 0.25s, background-color 0.25s;
  }
  .format:hover { box-shadow: inset 0 0 0 1px var(--nuit); }
  .format input { position: absolute; opacity: 0; inset: 0; cursor: pointer; margin: 0; }
  .format-label { font-weight: 600; }
  .format-price { font-size: 0.9rem; color: var(--damas); }
  .format:has(input:checked) { background: var(--nuit); color: var(--blanc); box-shadow: none; }
  .format:has(input:checked) .format-price { color: var(--petale); }
  .format:has(input:focus-visible) { outline: 2px solid var(--damas); outline-offset: 3px; }
  .product-flag { position: absolute; left: 50%; bottom: 1.25rem; translate: -50% 0; background: var(--nuit); color: var(--blanc); padding: 0.4rem 1rem; border-radius: 999px; font-weight: 700; }
  .product-flag--promo { background: var(--damas); }

  .product-info { display: grid; gap: var(--space-3); padding-top: var(--space-2); }
  .crumbs { font-size: 0.9rem; color: var(--ink-soft); }
  .crumbs a { color: inherit; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chips a, .chips span { display: inline-block; padding: 0.3rem 0.8rem; border-radius: 999px; font-size: 0.85rem; font-weight: 600; background: var(--blanc); text-decoration: none; }
  .chips a:hover { background: var(--petale); }
  .chips .chip-bio { background: var(--chaouen); color: var(--blanc); }
  .product-info h1 { font-size: var(--step-5); }
  .product-price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.75rem; }
  .product-price span { font-family: var(--font-display); font-size: var(--step-4); color: var(--damas); line-height: 1; }
  .product-price s { color: var(--ink-soft); font-size: var(--step-1); }
  .product-price small { color: var(--ink-soft); font-size: 0.85rem; }
  .product-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .soldout-note { width: 100%; font-weight: 600; }
  .product-reassure { font-size: 0.92rem; color: var(--ink-soft); }
  .product-desc { font-size: 1.08rem; max-width: 60ch; }

  .benefits { background: var(--blanc); border-radius: 2rem; padding: var(--space-3); }
  .benefits h2 { font-size: var(--step-2); margin-bottom: var(--space-2); }
  .benefits ul { display: grid; gap: 0.6rem; }
  .benefits li { position: relative; padding-left: 1.75rem; }
  .benefits li::before { content: ''; position: absolute; left: 0; top: 0.45em; width: 0.8rem; height: 0.8rem; background: var(--damas); clip-path: polygon(50% 0, 63% 37%, 100% 50%, 63% 63%, 50% 100%, 37% 63%, 0 50%, 37% 37%); }

  .details { border-top: 1px solid rgb(14 26 60 / 0.14); }
  .details details { border-bottom: 1px solid rgb(14 26 60 / 0.14); }
  .details summary {
    cursor: pointer; list-style: none; padding: 1.1rem 0; font-weight: 700; display: flex; justify-content: space-between; align-items: center;
  }
  .details summary::-webkit-details-marker { display: none; }
  .details summary::after { content: '+'; font-family: var(--font-display); font-size: 1.6rem; font-weight: 300; line-height: 1; transition: rotate 0.4s var(--ease-out); }
  .details details[open] summary::after { rotate: 45deg; }
  .details details > :not(summary) { margin-bottom: 1.1rem; color: var(--ink-soft); max-width: 62ch; }
  .details ul { padding-left: 1.2rem; display: grid; gap: 0.35rem; }
  .details a { color: var(--chaouen); }
  .small { font-size: 0.88rem; }

  .related h2 { margin-bottom: var(--space-4); }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); gap: var(--space-4) var(--space-3); }

  @media (max-width: 900px) {
    .product-grid { grid-template-columns: 1fr; }
    .product-media { position: static; max-width: 30rem; }
  }
</style>
