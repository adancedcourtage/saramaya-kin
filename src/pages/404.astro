---
import Base from '../layouts/Base.astro';
import Khatam from '../components/Khatam.astro';
---
<Base title="Page introuvable" headerTone="dark" noindex>
  <section class="nf on-dark">
    <Khatam class="nf-star" />
    <div class="container nf-inner">
      <p class="nf-code" aria-hidden="true">404</p>
      <h1>Vous vous êtes perdu dans la médina</h1>
      <p class="lede">Cette page n’existe pas ou a changé d’adresse. Reprenez la ruelle principale.</p>
      <div class="nf-actions">
        <a class="btn btn--light" href="/">Retour à l’accueil</a>
        <a class="btn btn--ghost" href="/argan">Gamme argan</a>
        <a class="btn btn--ghost" href="/rose">Gamme rose</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { position: relative; min-height: 100svh; display: grid; place-items: center; overflow: hidden; isolation: isolate; background: radial-gradient(60% 50% at 50% 100%, rgb(184 50 94 / 0.5), transparent 70%), var(--nuit); padding-block: 8rem 4rem; }
  .nf :global(.nf-star) { position: absolute; width: min(120vmin, 70rem); color: rgb(214 226 245 / 0.12); z-index: -1; animation: spin 120s linear infinite; }
  @keyframes spin { to { rotate: 360deg; } }
  .nf-inner { display: grid; justify-items: center; text-align: center; gap: var(--space-3); }
  .nf-code { font-family: var(--font-display); font-size: clamp(6rem, 25vw, 16rem); line-height: 0.8; font-style: italic; color: var(--petale); font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144; }
  .nf h1 { font-size: var(--step-4); max-width: 18ch; }
  .nf .lede { margin-inline: auto; }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
</style>
