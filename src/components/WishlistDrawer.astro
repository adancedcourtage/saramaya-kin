---
import Icon from './Icon.astro';
import { getImage } from 'astro:assets';
import { products, coffrets } from '../lib/catalog';
import { productImage } from '../lib/images';
import { site } from '../data/site';

const items = await Promise.all(
  [...products, ...coffrets].map(async (p) => {
    const img = await getImage({ src: productImage(p.image), width: 160, height: 160, format: 'webp' });
    return { slug: p.slug, name: p.name, price: p.price, image: img.src, soldOut: p.soldOut };
  }),
);
const config = { whatsapp: site.whatsapp, name: site.name, discount: site.bundleDiscount };
---
<dialog class="drawer" data-wishlist aria-labelledby="drawer-title">
  <div class="drawer-panel" data-lenis-prevent>
    <div class="drawer-head">
      <h2 id="drawer-title">Ma sélection</h2>
      <button type="button" class="drawer-close" data-wishlist-close>
        <Icon name="close" /><span class="visually-hidden">Fermer</span>
      </button>
    </div>

    <div class="drawer-empty" data-wishlist-empty>
      <p>Votre sélection est vide.</p>
      <p>Ajoutez des soins depuis les gammes, puis envoyez la liste en un message WhatsApp.</p>
      <div class="drawer-empty-links">
        <a class="btn" href="/argan">Voir l’argan</a>
        <a class="btn btn--rose" href="/rose">Voir la rose</a>
      </div>
    </div>

    <ul role="list" class="drawer-list" data-wishlist-list></ul>

    <div class="drawer-foot" data-wishlist-foot hidden>
      <dl class="drawer-totals">
        <div><dt>Sous-total</dt><dd data-wishlist-subtotal></dd></div>
        <div class="drawer-discount" data-wishlist-discount-row hidden>
          <dt>Remise {config.discount.percent} % dès {config.discount.minItems} produits</dt><dd data-wishlist-discount></dd>
        </div>
        <div class="drawer-total"><dt>Total estimé</dt><dd data-wishlist-total></dd></div>
      </dl>
      <p class="drawer-note" data-wishlist-hint></p>
      <p class="drawer-note">Frais de livraison et paiement confirmés sur WhatsApp avant toute validation.</p>
      <a class="btn btn--rose drawer-send" data-wishlist-send href="#" target="_blank" rel="noopener">
        <Icon name="whatsapp" /> Envoyer ma sélection sur WhatsApp
      </a>
      <button type="button" class="drawer-clear" data-wishlist-clear>Vider la sélection</button>
    </div>
  </div>
</dialog>

<div class="toast" role="status" aria-live="polite" data-toast></div>

<script type="application/json" id="catalog-data" set:html={JSON.stringify({ items, config })} />

<style>
  .drawer {
    margin: 0 0 0 auto; height: 100dvh; max-height: none; width: min(100%, 28rem);
    border: 0; padding: 0; background: transparent; color: var(--nuit);
  }
  .drawer::backdrop { background: rgb(14 26 60 / 0.5); backdrop-filter: blur(3px); }
  .drawer[open] .drawer-panel { animation: drawer-in 0.55s var(--ease-out); }
  @keyframes drawer-in { from { transform: translateX(100%); } }
  .drawer-panel {
    height: 100%; background: var(--aube); display: flex; flex-direction: column;
    padding: var(--space-3); gap: var(--space-3); overflow-y: auto;
    border-radius: 2rem 0 0 2rem;
  }
  .drawer-head { display: flex; justify-content: space-between; align-items: center; }
  .drawer-head h2 { font-size: var(--step-3); }
  .drawer-close { width: 2.75rem; height: 2.75rem; display: grid; place-items: center; border-radius: 999px; box-shadow: inset 0 0 0 1px currentColor; }
  .drawer-close svg { width: 1.3rem; height: 1.3rem; }
  .drawer-empty { display: grid; gap: var(--space-2); color: var(--ink-soft); }
  .drawer-empty p:first-child { font-family: var(--font-display); font-size: var(--step-2); color: var(--nuit); }
  .drawer-empty-links { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: var(--space-1); }
  .drawer-list { display: grid; gap: var(--space-2); }
  .drawer-list :global(li) { display: grid; grid-template-columns: 4.5rem 1fr auto; gap: 0.9rem; align-items: center; }
  .drawer-list :global(img) { width: 4.5rem; height: 4.5rem; object-fit: cover; border-radius: 999px 999px 0.75rem 0.75rem; }
  .drawer-list :global(.d-name) { font-weight: 600; line-height: 1.3; }
  .drawer-list :global(.d-price) { color: var(--damas); font-size: 0.95rem; }
  .drawer-list :global(.d-qty) { display: inline-flex; align-items: center; gap: 0.25rem; border-radius: 999px; box-shadow: inset 0 0 0 1px rgb(14 26 60 / 0.25); }
  .drawer-list :global(.d-qty button) { width: 2.25rem; height: 2.25rem; display: grid; place-items: center; border-radius: 999px; }
  .drawer-list :global(.d-qty button:hover) { background: var(--petale); }
  .drawer-list :global(.d-qty svg) { width: 1rem; height: 1rem; }
  .drawer-list :global(.d-qty output) { min-width: 1.25rem; text-align: center; font-weight: 600; }
  .drawer-foot { margin-top: auto; display: grid; gap: var(--space-2); padding-top: var(--space-3); border-top: 1px solid rgb(14 26 60 / 0.12); }
  .drawer-totals { display: grid; gap: 0.35rem; }
  .drawer-totals div { display: flex; justify-content: space-between; gap: 1rem; }
  .drawer-totals dd { font-weight: 600; }
  .drawer-discount { color: var(--damas); }
  .drawer-total { font-family: var(--font-display); font-size: var(--step-2); }
  .drawer-total dd { font-weight: 400; }
  .drawer-note { font-size: var(--step--1); color: var(--ink-soft); }
  .drawer-send { width: 100%; }
  .drawer-clear { justify-self: center; font-size: 0.9rem; text-decoration: underline; color: var(--ink-soft); padding: 0.5rem; }

  .toast {
    position: fixed; left: 50%; bottom: 1.5rem; z-index: 150; translate: -50% 2rem;
    background: var(--nuit); color: var(--blanc); padding: 0.85rem 1.4rem; border-radius: 999px;
    box-shadow: var(--shadow-lift); opacity: 0; pointer-events: none;
    transition: opacity 0.35s var(--ease-out), translate 0.5s var(--ease-out);
    max-width: calc(100% - 2rem); text-align: center;
  }
  .toast.is-visible { opacity: 1; translate: -50% 0; }
  @media (max-width: 480px) { .drawer-panel { border-radius: 0; } }
</style>
