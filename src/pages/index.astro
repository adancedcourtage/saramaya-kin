---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import Khatam from '../components/Khatam.astro';
import { products, byRange, coffrets, promoProduct, formatPrice, discountPercent } from '../lib/catalog';
import { productImage } from '../lib/images';
import { waLink } from '../lib/whatsapp';
import { site } from '../data/site';
import { reviews } from '../data/reviews';

/** Public asset path that also works when the site is served from a sub-path. */
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${path}`;

const featuredSlugs = ['huile-d-argan', 'huile-de-rose', 'creme-a-l-argan', 'eau-de-rose', 'masque-argan-et-rose', 'serum-encens-et-argan', 'savon-a-la-rose', 'lait-corporel-argan-250ml'];
const featured = featuredSlugs.map((s) => products.find((p) => p.slug === s)).filter((p) => p && !p.soldOut);
const promo = promoProduct();
const argan = byRange('argan');
const rose = byRange('rose');
const coffret = coffrets.find((c) => !c.soldOut) ?? coffrets[0];

const assurances = [
  { icon: 'star', text: 'Fabriqué au Maroc' },
  { icon: 'truck', text: `Livraison en ${site.delivery.zone}` },
  { icon: 'tag', text: `-${site.bundleDiscount.percent} % dès ${site.bundleDiscount.minItems} produits` },
  { icon: 'return', text: 'Retours sous 14 jours' },
] as const;

const steps = [
  { title: 'Choisissez', text: 'Ajoutez vos soins au panier, ou demandez conseil si vous hésitez.' },
  { title: 'Envoyez', text: 'Un clic ouvre WhatsApp avec votre liste, les prix et le total déjà rédigés.' },
  { title: 'Confirmez', text: 'Nous vous répondons avec les frais de livraison et le moyen de paiement. Rien n’est validé sans votre accord écrit.' },
  { title: 'Recevez', text: 'Votre colis part après paiement, avec un suivi envoyé sur WhatsApp.' },
];
---
<Base title={site.name} headerTone="dark">
  <!-- Story: hero + night-to-dawn passage share one 3D backdrop (rose valley, then argan workshop) -->
  <div class="story" data-story>
  <div class="story-bg" aria-hidden="true">
   <div class="story-bg-inner">
    <img class="story-fallback" src={asset('/scene/rose-maroc.webp')} alt="" width="1600" height="1067" fetchpriority="high" decoding="async" />
    <div
      class="story-scene"
      data-scene
      data-a={asset('/scene/rose-maroc.webp')}
      data-ad={asset('/scene/rose-maroc-depth.png')}
      data-b={asset('/scene/argan-maroc.webp')}
      data-bd={asset('/scene/argan-maroc-depth.png')}
    ></div>
   </div>
  </div>

  <!-- Hero: the blue night, petals drifting -->
  <section class="hero on-dark" aria-labelledby="hero-title">
    <div class="hero-sky" aria-hidden="true">
      <Khatam class="hero-star" />
      <div class="hero-petals" data-petals></div>
    </div>
    <div class="container hero-inner">
      <h1 id="hero-title" class="hero-title" data-split="load">De la nuit bleue à l’aube rose</h1>
      <p class="hero-lede" data-reveal>
        Huile d’argan du Souss, rose de Damas de Kelaat M’Gouna. Des soins façonnés au Maroc pour celles et ceux qui avancent, chaque jour, un peu plus loin.
      </p>
      <div class="hero-actions" data-reveal>
        <a class="btn btn--light" href="#mondes" data-magnetic>Découvrir les soins</a>
        <a class="btn btn--ghost" href={waLink('je souhaite commander.')} target="_blank" rel="noopener" data-magnetic>
          <Icon name="whatsapp" /> Commander sur WhatsApp
        </a>
      </div>
    </div>
    <ul role="list" class="container assurances" aria-label="Nos engagements" data-reveal>
      {assurances.map((a) => (
        <li><Icon name={a.icon} /><span>{a.text}</span></li>
      ))}
    </ul>
  </section>

  <!-- The passage from night to dawn -->
  <section class="dawn" id="manifeste" data-dawn aria-label="Notre manifeste">
    <div class="dawn-sticky">
      <div class="dawn-hills" aria-hidden="true">
        <svg viewBox="0 0 1440 260" preserveAspectRatio="none"><path d="M0 170c120-40 220-70 340-50s200 70 330 60 210-90 360-100 260 40 410 70v150H0Z" /></svg>
      </div>
      <div class="container dawn-text">
        <p data-dawn-line class="is-active">La nuit, Chefchaouen se drape de bleu.</p>
        <p data-dawn-line>À l’aube, la Vallée des Roses s’éveille.</p>
        <p data-dawn-line>Entre les deux, un geste transmis de main en main : prendre soin de soi pour aller plus loin.</p>
      </div>
    </div>
  </section>
  </div>

  <!-- Two worlds -->
  <section class="worlds" id="mondes" aria-labelledby="mondes-title">
    <div class="container">
      <div class="section-head">
        <h2 id="mondes-title" data-split>Deux gammes, un même rituel</h2>
        <p class="lede" data-reveal>L’argan nourrit et répare, la rose apaise et illumine. Choisissez votre point de départ.</p>
      </div>
    </div>
    <div class="worlds-split">
      <a class="world world--argan on-dark" href="/argan">
        <Image src={productImage('collection-gamme-argan.jpg')} alt="" widths={[600, 900, 1200]} sizes="(max-width: 800px) 100vw, 60vw" class="world-img" />
        <div class="world-copy">
          <p class="world-count">{argan.length} soins</p>
          <h3>L’or du Souss</h3>
          <p>Huiles pressées à froid, crèmes, masques et gommages à l’argan.</p>
          <span class="world-cta">Explorer la gamme argan</span>
        </div>
      </a>
      <a class="world world--rose on-dark" href="/rose">
        <Image src={productImage('collection-gamme-rose.jpg')} alt="" widths={[600, 900, 1200]} sizes="(max-width: 800px) 100vw, 60vw" class="world-img" />
        <div class="world-copy">
          <p class="world-count">{rose.length} soins</p>
          <h3>La rose de Damas</h3>
          <p>Eau florale, huiles, crèmes et savons aux pétales de Kelaat M’Gouna.</p>
          <span class="world-cta">Explorer la gamme rose</span>
        </div>
      </a>
    </div>
  </section>

  <!-- Favourites rail -->
  <section class="section favourites" aria-labelledby="fav-title">
    <div class="container fav-head">
      <h2 id="fav-title" data-split>Les soins qu’on nous redemande</h2>
      <p class="lede" data-reveal>Faites glisser pour parcourir. Dès {site.bundleDiscount.minItems} produits, {site.bundleDiscount.percent} % de remise s’appliquent à votre panier.</p>
    </div>
    <div class="rail" tabindex="0" role="region" aria-label="Produits favoris">
      <ul role="list" class="rail-track">
        {featured.map((p, i) => <li><ProductCard product={p!} eager={i < 2} /></li>)}
      </ul>
    </div>
  </section>

  <!-- How to order -->
  <section class="section steps" aria-labelledby="steps-title">
    <div class="container">
      <div class="section-head">
        <h2 id="steps-title" data-split>Commander en quatre étapes</h2>
        <p class="lede" data-reveal>Pas de compte à créer, pas de paiement en ligne. Une vraie conversation avec nous.</p>
      </div>
      <ol role="list" class="steps-list">
        {steps.map((s, i) => (
          <li data-reveal>
            <span class="step-num" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {reviews.length > 0 && (
    <section class="section reviews" aria-labelledby="reviews-title">
      <div class="container">
        <h2 id="reviews-title" data-split>Elles et ils en parlent</h2>
        <ul role="list" class="reviews-list">
          {reviews.map((r) => (
            <li data-reveal>
              <blockquote><p>{r.text}</p></blockquote>
              <p class="review-by">{r.name}, {r.city}{r.product && <>, {r.product}</>}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {promo && (
    <section class="promo" data-promo aria-labelledby="promo-title">
      <div class="container promo-grid">
        <a href={`/produit/${promo.slug}`} class="promo-media arch" data-tilt>
          <Image src={productImage(promo.image)} alt={promo.name} widths={[400, 700]} sizes="(max-width: 800px) 90vw, 40vw" />
        </a>
        <div class="promo-copy">
          <p class="promo-tag">Soin du mois, -{discountPercent(promo.price, promo.compareAt)} %</p>
          <h2 id="promo-title">{promo.name}</h2>
          <p class="lede">{promo.tagline}</p>
          <p class="promo-price"><span>{formatPrice(promo.price)}</span> <s>{formatPrice(promo.compareAt!)}</s></p>
          <div class="countdown" data-countdown={site.promo.endsAt} role="timer" aria-label="Temps restant avant la fin de l’offre">
            <div><span data-days>00</span><small>jours</small></div>
            <div><span data-hours>00</span><small>heures</small></div>
            <div><span data-minutes>00</span><small>minutes</small></div>
            <div><span data-seconds>00</span><small>secondes</small></div>
          </div>
          <div class="promo-actions">
            <button type="button" class="btn btn--rose" data-add={promo.slug} data-magnetic>Ajouter au panier</button>
            <a class="link-underline" href={`/produit/${promo.slug}`}>Voir le détail</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Coffrets -->
  <section class="section coffret-teaser" aria-labelledby="coffret-title">
    <div class="container coffret-grid">
      <div class="coffret-copy">
        <h2 id="coffret-title" data-split>Offrir un rituel, ou composer le vôtre</h2>
        <p class="lede" data-reveal>Coffrets prêts à offrir, ou coffret sur mesure : choisissez vos soins, nous l’assemblons à la main.</p>
        <div class="coffret-actions" data-reveal>
          <a class="btn" href="/coffrets" data-magnetic>Voir les coffrets</a>
          <a class="link-underline" href="/coffrets#composer">Composer mon coffret</a>
        </div>
      </div>
      <a class="coffret-media arch" href="/coffrets" data-reveal>
        <Image src={productImage(coffret.image)} alt={coffret.name} widths={[400, 700, 1000]} sizes="(max-width: 800px) 90vw, 45vw" data-parallax="8" />
        <span class="coffret-label">{coffret.name}, {formatPrice(coffret.price)}</span>
      </a>
    </div>
  </section>

  <!-- Origins route -->
  <section class="section origins on-dark" aria-labelledby="origins-title">
    <Khatam class="origins-star" />
    <div class="container origins-grid">
      <div class="section-head">
        <h2 id="origins-title" data-split>Du nord au sud du Maroc</h2>
        <p class="lede" data-reveal>Trois lieux, trois lumières. Chaque soin raconte une partie de ce voyage.</p>
      </div>
      <ol role="list" class="route">
        <li data-reveal>
          <h3>Chefchaouen</h3>
          <p class="route-where">Montagnes du Rif</p>
          <p>La ville bleue nous a donné notre couleur : celle de la nuit, du calme, du temps qu’on prend pour soi.</p>
        </li>
        <li data-reveal>
          <h3>Kelaat M’Gouna</h3>
          <p class="route-where">Vallée des Roses, Haut Atlas</p>
          <p>Chaque printemps, les roses de Damas y sont cueillies à l’aube, avant que le soleil n’emporte leur parfum.</p>
        </li>
        <li data-reveal>
          <h3>Le Souss</h3>
          <p class="route-where">Forêts d’arganiers, sud-ouest</p>
          <p>L’arganier ne pousse presque nulle part ailleurs. Ses noix sont concassées puis pressées à froid pour garder leurs acides gras et leur vitamine E.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Final call -->
  <section class="final" aria-labelledby="final-title">
    <div class="container final-inner">
      <h2 id="final-title" data-split>Votre rituel commence par un message</h2>
      <p class="lede" data-reveal>Une question sur un soin, un conseil pour votre peau ou vos cheveux ? Nous répondons personnellement.</p>
      <a class="btn btn--rose" href={waLink('je souhaite des conseils pour choisir mes soins.')} target="_blank" rel="noopener" data-magnetic data-reveal>
        <Icon name="whatsapp" /> Parler avec nous sur WhatsApp
      </a>
    </div>
  </section>
</Base>

<style>
  /* ---------- Story backdrop (shared by hero + dawn) ---------- */
  .story { position: relative; isolation: isolate; }
  /* The backdrop fills the story area only; its inner layer sticks to the viewport while scrolling through it. */
  .story-bg { position: absolute; inset: 0; z-index: -1; overflow: clip; }
  .story-bg-inner { position: sticky; top: 0; height: 100svh; overflow: hidden; background: var(--nuit); }
  .story-fallback {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 55% 50%;
    filter: brightness(0.4) saturate(0.6) hue-rotate(-12deg) contrast(1.05);
    transition: opacity 1.4s var(--ease-out);
  }
  .story-bg-inner::after { content: ''; position: absolute; inset: 0; background: rgb(23 40 90 / 0.45); mix-blend-mode: multiply; transition: opacity 1.4s; }
  .story-scene { position: absolute; inset: 0; opacity: 0; transition: opacity 1.4s var(--ease-out); }
  .story-scene:global(.is-live) { opacity: 1; }
  .story-scene :global(canvas) { width: 100% !important; height: 100% !important; display: block; }
  .story-bg-inner:has(:global(.is-live))::after, .story-bg-inner:has(:global(.is-live)) .story-fallback { opacity: 0; }

  /* ---------- Hero ---------- */
  .hero {
    position: relative; min-height: 100svh; display: grid; align-content: end;
    background:
      radial-gradient(60% 45% at 80% 110%, rgb(184 50 94 / 0.35), transparent 70%),
      linear-gradient(to top, rgb(14 26 60 / 0.9) 0%, rgb(14 26 60 / 0.35) 55%, rgb(14 26 60 / 0.6) 100%);
    overflow: hidden; isolation: isolate;
    padding-block: 7rem clamp(1.5rem, 4vh, 3rem);
  }
  .hero-sky { position: absolute; inset: 0; z-index: -1; }
  .hero :global(.hero-star) {
    position: absolute; width: min(95vmin, 60rem); right: -12vmin; top: 50%; translate: 0 -50%;
    color: rgb(214 226 245 / 0.12); animation: spin 140s linear infinite;
  }
  @keyframes spin { to { rotate: 360deg; } }
  .hero-petals { position: absolute; inset: 0; opacity: 0; transition: opacity 2s var(--ease-out); }
  .hero-petals:global(.is-live) { opacity: 1; }
  .hero-petals :global(canvas) { width: 100% !important; height: 100% !important; }
  .hero-inner { display: grid; gap: var(--space-3); }
  @media (max-width: 760px) {
    .hero { padding-top: 5.5rem; }
    .hero-inner { gap: var(--space-2); }
    .hero-lede { font-size: 1.05rem; }
  }
  .hero-title {
    font-size: var(--step-6); line-height: 0.92; letter-spacing: -0.03em; max-width: 12ch;
  }
  .hero-lede { font-size: var(--step-1); max-width: 40ch; color: var(--brume); line-height: 1.5; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .assurances {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem;
    margin-top: clamp(2rem, 6vh, 4rem); padding-top: 1.25rem;
    border-top: 1px solid rgb(214 226 245 / 0.22);
    font-size: 0.95rem; color: var(--brume);
  }
  .assurances li { display: flex; align-items: center; gap: 0.6rem; }
  .assurances :global(svg) { width: 1.25rem; height: 1.25rem; flex: none; color: var(--petale); }
  @media (max-width: 760px) {
    .assurances { grid-template-columns: 1fr 1fr; gap: 0.75rem 1rem; font-size: 0.85rem; }
  }

  /* ---------- Dawn passage ---------- */
  .dawn {
    --sky-top: var(--nuit); --sky-bottom: var(--nuit-2); --p: 0;
    height: 250vh; position: relative;
  }
  .dawn-sticky {
    position: sticky; top: 0; height: 100svh; overflow: hidden; display: grid; place-items: center;
    /* light veil tinted by the sky colour, the 3D scene shows through */
    background:
      radial-gradient(65% 50% at 50% 50%, rgb(14 26 60 / 0.62), transparent 78%),
      linear-gradient(to bottom, color-mix(in srgb, var(--sky-top) 40%, transparent), transparent 50%);
    color: var(--blanc);
  }
  .dawn-text p { text-shadow: 0 2px 30px rgb(14 26 60 / 0.6), 0 1px 3px rgb(14 26 60 / 0.4); }
  .dawn-hills { position: absolute; inset: auto 0 -1px; height: 34vh; z-index: 1; }
  /* the hills only rise at the very end, to hand over to the light sections below */
  .dawn-hills { translate: 0 calc((1 - clamp(0, calc((var(--p) - 0.86) * 7.2), 1)) * 101%); }
  .dawn-hills svg { width: 100%; height: 100%; fill: var(--chaux); }
  .dawn-text { position: relative; display: grid; text-align: center; justify-items: center; }
  .dawn-text p {
    grid-area: 1 / 1; max-width: 22ch;
    font-family: var(--font-display); font-size: var(--step-5); line-height: 1.05; letter-spacing: -0.02em;
    opacity: 0; transform: translateY(2rem) scale(0.98); filter: blur(8px);
    transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out), filter 0.9s var(--ease-out);
  }
  .dawn-text p:global(.is-active) { opacity: 1; transform: none; filter: none; }
  .dawn:global(.is-static) { height: auto; }
  .dawn:global(.is-static) .dawn-sticky { position: relative; height: auto; padding-block: var(--space-6); background: linear-gradient(var(--nuit), var(--chaouen) 60%, var(--damas)); }
  .dawn:global(.is-static) .dawn-text { gap: var(--space-3); }
  .dawn:global(.is-static) .dawn-text p { grid-area: auto; opacity: 1; transform: none; filter: none; font-size: var(--step-4); }
  :global(.no-js) .dawn { height: auto; }
  :global(.no-js) .dawn-sticky { position: relative; height: auto; padding-block: var(--space-6); }
  :global(.no-js) .dawn-text { gap: var(--space-3); }
  :global(.no-js) .dawn-text p { grid-area: auto; opacity: 1; transform: none; filter: none; }

  /* ---------- Two worlds ---------- */
  .worlds { position: relative; padding-top: var(--space-5); background: var(--chaux); }
  .worlds-split { display: flex; gap: 0.75rem; padding-inline: var(--gutter); height: min(80vh, 46rem); }
  .world {
    position: relative; flex: 1; display: flex; align-items: flex-end; overflow: hidden; text-decoration: none;
    border-radius: 999px 999px 1.5rem 1.5rem; isolation: isolate;
    transition: flex-grow 0.9s var(--ease-out);
  }
  .world:hover, .world:focus-visible { flex-grow: 1.7; }
  .world :global(.world-img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1.4s var(--ease-out); }
  .world:hover :global(.world-img) { transform: scale(1.05); }
  .world::after { content: ''; position: absolute; inset: 0; z-index: -1; }
  .world--argan::after { background: linear-gradient(to top, rgb(14 26 60 / 0.92) 10%, rgb(23 40 90 / 0.35) 55%, transparent); }
  .world--rose::after { background: linear-gradient(to top, rgb(143 33 71 / 0.92) 10%, rgb(184 50 94 / 0.3) 55%, transparent); }
  .world-copy { padding: clamp(1.5rem, 4vw, 3rem); display: grid; gap: 0.5rem; max-width: 30rem; }
  .world-copy h3 { font-size: var(--step-4); }
  .world-count { font-weight: 600; color: var(--petale); }
  .world-cta { margin-top: 0.5rem; font-weight: 600; text-decoration: underline; text-underline-offset: 0.3em; text-decoration-color: var(--petale); }
  @media (max-width: 800px) {
    .worlds-split { flex-direction: column; height: auto; }
    .world { min-height: 70vh; }
    .world:hover { flex-grow: 1; }
  }

  /* ---------- Favourites rail ---------- */
  .fav-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-3); margin-bottom: var(--space-4); }
  .fav-head h2 { max-width: 14ch; }
  .fav-head .lede { max-width: 34ch; }
  .rail { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-block: 1rem 2rem; }
  .rail::-webkit-scrollbar { display: none; }
  .rail:focus-visible { outline-offset: -4px; }
  .rail-track {
    display: grid; grid-auto-flow: column; grid-auto-columns: clamp(15rem, 26vw, 21rem); gap: clamp(1rem, 2vw, 2rem);
    padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2));
  }
  .rail-track > li { scroll-snap-align: start; scroll-margin-inline: var(--gutter); }
  .rail-track > li:nth-child(even) { margin-top: 3rem; }

  /* ---------- Promo ---------- */
  .promo { padding-block: var(--space-6); background: linear-gradient(160deg, var(--aube), var(--petale)); }
  .promo-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: var(--space-5); align-items: center; }
  .promo-media { aspect-ratio: 4 / 5; display: block; background: var(--blanc); box-shadow: var(--shadow-lift); }
  .promo-media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .promo-copy { display: grid; gap: var(--space-2); justify-items: start; }
  .promo-tag { font-weight: 700; color: var(--damas-deep); }
  .promo-price span { font-family: var(--font-display); font-size: var(--step-4); color: var(--damas); }
  .promo-price s { color: var(--ink-soft); font-size: var(--step-1); }
  .countdown { display: flex; gap: 0.5rem; }
  .countdown div { display: grid; justify-items: center; min-width: 4.5rem; padding: 0.75rem 0.5rem; border-radius: 999px 999px 1rem 1rem; background: var(--nuit); color: var(--blanc); }
  .countdown span { font-family: var(--font-display); font-size: var(--step-3); line-height: 1; font-variant-numeric: tabular-nums; }
  .countdown small { font-size: 0.75rem; color: var(--brume); }
  .promo-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; margin-top: var(--space-1); }
  @media (max-width: 800px) { .promo-grid { grid-template-columns: 1fr; } .promo-media { max-width: 24rem; } .countdown div { min-width: 0; flex: 1; } }

  /* ---------- Coffret teaser ---------- */
  .coffret-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); align-items: center; }
  .coffret-copy { display: grid; gap: var(--space-3); }
  .coffret-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; }
